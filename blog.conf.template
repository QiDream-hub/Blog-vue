server {
    listen 80;
    server_name _;

    # 开启 gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/xml+rss image/svg+xml;

    location / {
        root /blog/dist;
        try_files $uri $uri/ /index.html;
    }

    location = /api/batch {
        limit_except GET POST { deny all; }
        proxy_method GET;
        proxy_pass http://${META_SERVICE_URL}/batch;
        proxy_pass_request_body on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /api/ {
        limit_except GET { deny all; }
        proxy_pass http://${META_SERVICE_URL}/;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /img/ {
        alias /blog/images/;
        expires 30d;
    }

    location /article/ {
        alias /blog/articles/;
        default_type text/markdown;
    }
}